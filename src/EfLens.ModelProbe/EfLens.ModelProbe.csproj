<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs inside the target app's AssemblyLoadContext, so it binds to the app's own EF Core assemblies.
    EF Core is a compile-only reference: none of its DLLs are shipped with EfLens.
    It is compiled against the oldest supported EF Core (10, LTS); newer versions satisfy the reference.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
