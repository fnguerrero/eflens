<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Shipped as a .NET tool (framework-dependent: it needs the same runtime as the apps it loads) and tagged as an
    MCP server, so NuGet.org lists it as one and `dnx EfLens` runs it. Keep Version in sync with .mcp/server.json;
    the release workflow refuses a tag that does not match both.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>eflens</ToolCommandName>
    <PackageType>McpServer</PackageType>
    <PackageId>EfLens</PackageId>
    <Version>0.1.0</Version>
    <Authors>fnguerrero</Authors>
    <Description>Read-only MCP server that lets AI agents inspect SQLite, SQL Server and PostgreSQL databases safely, read your EF Core model and detect model/schema drift.</Description>
    <PackageTags>mcp;mcp-server;model-context-protocol;efcore;entity-framework-core;database;sql-server;postgresql;sqlite;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fnguerrero/eflens</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fnguerrero/eflens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include=".mcp/server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

  <!-- The probe ships inside tools/ with the rest of the publish output, never as contentFiles for consumers. -->
  <Target Name="KeepProbeOutOfContentFiles" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_EfLensProbe Include="@(Content)" Condition="'%(Filename)%(Extension)' == 'EfLens.ModelProbe.dll'" />
      <Content Remove="@(_EfLensProbe)" />
      <Content Include="@(_EfLensProbe)" Pack="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="EfLens.Tests" />
  </ItemGroup>

  <!--
    The probe is never referenced at compile time: it is copied next to EfLens.dll and loaded into the
    target app's AssemblyLoadContext. Only the JSON contract is shared, as linked source.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EfLens.ModelProbe\EfLens.ModelProbe.csproj" ReferenceOutputAssembly="false" OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\EfLens.ModelProbe\EfModelContract.cs" Link="Ef\EfModelContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- SqlClient 7.1.1 pulls Pkcs 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): pin the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
