<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EfLens.Tests" />
  </ItemGroup>

  <!--
    The probe is never referenced at compile time: it is copied next to EfLens.dll and loaded into the
    target app's AssemblyLoadContext. Only the JSON contract is shared, as linked source.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EfLens.ModelProbe\EfLens.ModelProbe.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest"
                      CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\EfLens.ModelProbe\EfModelContract.cs" Link="Ef\EfModelContract.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.1" />
    <!-- SqlClient 7.1.1 pulls Pkcs 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): pin the patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
  </ItemGroup>

</Project>
