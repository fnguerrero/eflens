<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EfLens\EfLens.csproj" />
    <!-- Built first, never referenced: the tests load it the way EfLens loads any app, from its bin folder. -->
    <ProjectReference Include="..\..\samples\Shop\Shop.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ShopAssembly</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../samples/Shop/bin/$(Configuration)/net10.0/Shop.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>